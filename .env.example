# ── LLM provider ────────────────────────────────────────────────────────────────
# Which LLM backend to use. Options: "gemini" (default) or "ollama" (local).
NUXT_LLM_PROVIDER=gemini

# ── Gemini API key ───────────────────────────────────────────────────────────────
# Free tier at https://aistudio.google.com/apikey
# The NUXT_ prefix lets Nuxt inject this at runtime instead of baking it into the build.
NUXT_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Ollama server URL (only needed if NUXT_LLM_PROVIDER=ollama)
# NUXT_OLLAMA_URL=http://localhost:11434

# ── Admin password ────────────────────────────────────────────────────────────────
# Protects /admin/upload and POST /api/generate.
# Leave unset in local dev — the middleware allows all requests when no password is configured.
# NUXT_ADMIN_PASSWORD=your_secure_password_here

# ── Public site URL ──────────────────────────────────────────────────────────────
# Used for canonical <link> tags, JSON-LD, og:image, and the sitemap.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
