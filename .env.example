# ── LLM Provider ────────────────────────────────────────────────────────────────
# Which LLM backend to use. Options: "gemini" (default) or "ollama" (local).
LLM_PROVIDER=gemini

# Google Gemini API key — free tier at https://aistudio.google.com/apikey
# Never commit the real .env file; this example is safe to commit.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Ollama server URL (only needed if LLM_PROVIDER=ollama)
# OLLAMA_URL=http://localhost:11434

# ── Public site URL ──────────────────────────────────────────────────────────────
# Used for canonical <link> tags and JSON-LD schema URLs.
# Change to your production domain before deploying.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
